{
  "buildCommand": "prisma generate && node scripts/vercel-build.mjs",
  "framework": "nextjs",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/cron/reminders?tasks=reminders",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    }
  ]
}
